# 复制为.env后生效：Copy-Item .env.example .env
PORT=3000

# 大模型方案：ollama表示本地模型，bailian表示阿里百炼在线模型。
LLM_PROVIDER=ollama

# Ollama默认只监听本机11434端口，不需要API Key。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 先执行：ollama pull qwen3:1.7b
OLLAMA_MODEL=qwen3:0.6b

# 阿里百炼在线方案。真实Key只能写在.env中，不能写在本文件。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=glm-5.1
